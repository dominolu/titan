+impl StrategyClock for Clock {
+    fn now_ns(&self) -> i64 {
+        if self.block.swap(false, Ordering::AcqRel) {
+            self.entered.send(()).unwrap();
+            self.release
+                .lock()
+                .unwrap()
+                .recv_timeout(Duration::from_secs(10))
+                .unwrap();
+        }
+        1_000_000_000
